@model List<string>

@{
    ViewData["Title"] = "Entities";
}

<h2>Entities</h2>

<div class="row">
    @foreach (var entity in Model)
    {
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">@entity</h5>
                    <a href="@Url.Action("Details", "Entities", new { entityName = entity })" class="btn btn-primary">View Details</a>
                </div>
            </div>
        </div>
    }
</div>